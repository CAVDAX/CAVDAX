#!/usr/bin/env sh
# CAVDAX Tier 2: Developer Workstation Pre-Commit Invariant Guard
# Validates all staged source files against the causal decision graph in FalkorDB.
# To activate: git config core.hooksPath .githooks

echo "[CAVDAX] Running Tier 2 Pre-Commit Causal Invariant Guard..."

if [ -f "scripts/lint-markdown.mjs" ]; then
  node scripts/lint-markdown.mjs --staged
  MD_EXIT=$?
  if [ $MD_EXIT -ne 0 ]; then
    echo "[CAVDAX] Commit aborted: Staged Markdown files contain GFM indented code block traps or CRCRLF corruption."
    exit 1
  fi
fi

if [ -f "scripts/lint-clean-svgs.mjs" ]; then
  node scripts/lint-clean-svgs.mjs --staged
  SVG_EXIT=$?
  if [ $SVG_EXIT -ne 0 ]; then
    echo "[CAVDAX] Commit aborted: Staged UI components violate the Anti-Squircle Direct SVG Invariant (Rule 0ad)."
    exit 1
  fi
fi

if [ -f "scripts/test-ci.mjs" ]; then
  echo "[CAVDAX] Running Headless CI Simulation Test Suite (CI=true)..."
  node scripts/test-ci.mjs
  TEST_EXIT=$?
  if [ $TEST_EXIT -ne 0 ]; then
    echo "[CAVDAX] Commit aborted: One or more unit tests or architectural invariants failed in simulated CI."
    exit 1
  fi
fi

if command -v npx >/dev/null 2>&1; then
  node apps/mcp-server/bin/cavdax.js check --staged
  EXIT_CODE=$?
  if [ $EXIT_CODE -ne 0 ]; then
    echo "[CAVDAX] Commit aborted: Staged modifications violate active Architecture Decision Records."
    echo "         Run 'npx @cavdax/mcp-server doctor' or verify decisions in the CAVDAX Console."
    exit 1
  fi
fi

exit 0
